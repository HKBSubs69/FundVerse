rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Donations ---
    // Raw donor data (name, email, transaction ID) is never exposed
    // to the public site. Only signed-in admins (the same Firebase
    // Auth login used by admin.html) may read this collection. The
    // public progress bar instead reads PublicStats/CampaignTotals
    // below, which a Cloud Function keeps in sync.
    match /ComicProjectDonations/{donationId} {

      allow read: if request.auth != null;

      // Clients may ONLY create a brand-new Manual UPI record, and
      // only in the exact shape the app writes. Everything else is
      // blocked:
      //  - No paymentMethod other than "manual-upi"
      //  - status must be exactly "confirmed" (never "SUCCESS",
      //    which is reserved for Cloud-Function-verified Cashfree
      //    payments)
      //  - No orderId field (that's how Cashfree docs are keyed —
      //    disallowing it here stops a client from impersonating one)
      //  - timestamp must be the server timestamp, not a spoofed value
      //  - consentAccepted must be explicitly true (Terms & Privacy
      //    Policy acceptance is required before any contribution)
      //  - phone/countryCode, if present, must be strings (they are
      //    optional for Manual UPI)
      allow create: if
        request.resource.data.paymentMethod == "manual-upi" &&
        request.resource.data.status == "confirmed" &&
        request.resource.data.consentAccepted == true &&
        !("orderId" in request.resource.data) &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 && request.resource.data.email.size() < 200 &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 && request.resource.data.amount <= 1000000 &&
        request.resource.data.txnID is string &&
        request.resource.data.txnID.size() > 0 && request.resource.data.txnID.size() < 100 &&
        (!("phone" in request.resource.data) || request.resource.data.phone is string) &&
        (!("countryCode" in request.resource.data) || request.resource.data.countryCode is string);

      // No client — authenticated or not — may ever update or delete
      // a donation record. This is what prevents:
      //  - Flipping a Cashfree order from PENDING/FAILED to SUCCESS
      //  - Editing/deleting another contributor's Manual UPI entry
      //  - Any client-side tampering with amounts after submission
      // Only the Cloud Functions (Admin SDK, which ignores these
      // rules entirely) can write SUCCESS/FAILED status.
      allow update, delete: if false;
    }

    // --- Public aggregate stats ---
    // The only donation-derived data the public site can read: a
    // running total and contributor count, maintained exclusively by
    // the onDonationWrite Cloud Function (Admin SDK).
    match /PublicStats/{statId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Webhook replay-protection ledger ---
    // Written only by the cashfreeWebhook Cloud Function via the
    // Admin SDK. No client access at all.
    match /WebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // --- Admin user metadata (if used) ---
    // Only accessible to signed-in users, and only their own record.
    match /AdminUsers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
